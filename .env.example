# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Which provider a Bot uses when it has no override of its own.
# Every Bot can choose its own provider and model in its settings.
LLM_PROVIDER=minimax

# MiniMax (Anthropic-compatible endpoint)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MODELS=MiniMax-M3,MiniMax-M2.1,MiniMax-M2.1-highspeed,MiniMax-M2
MINIMAX_MAX_TOKENS=16000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODELS=claude-sonnet-4-5,claude-opus-4-1,claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=16000

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner,deepseek-flash

# OpenRouter (many models behind one key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m2
OPENROUTER_MODELS=minimax/minimax-m2,deepseek/deepseek-chat,xiaomi/mimo-v2-flash

# Grok on xAI (adds hosted web/X search to the model itself)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_BUILTIN_SEARCH=1

# Any other OpenAI-compatible API (MiMo, a gateway, a local server).
# Each entry becomes a provider a Bot can be pointed at.
#   PROVIDERS_JSON=[{"id":"mimo","label":"MiMo","kind":"openai",
#     "baseUrl":"https://api.xiaomimimo.com/v1","apiKey":"sk-...",
#     "models":["mimo-v2-flash"],"defaultModel":"mimo-v2-flash"}]
PROVIDERS_JSON=

# A local OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_ID=local
OPENAI_COMPATIBLE_LABEL=Local model
OPENAI_COMPATIBLE_MODEL=

# Offline mock provider, for trying Guild without spending tokens.
# HIVE_ALLOW_MOCK=1
# LLM_PROVIDER=mock

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=                   # openssl rand -hex 32
DEV_LOGIN=1                       # 1 enables POST /api/auth/dev (local testing only)
# DB_PATH=data/guild.db

# ---------------------------------------------------------------------------
# This computer
# ---------------------------------------------------------------------------
# Folders Bots may read and write. Separate with ; (or , on Windows).
# Each Bot also has its own workspace under data/workspaces/.
LOCAL_ROOTS=

# A folder that syncs through the cloud (Google Drive for Desktop, OneDrive,
# Dropbox, Syncthing). Bots push and pull their workspace through it, which is
# how work moves from one computer to another.
CLOUD_ROOT=

# ---------------------------------------------------------------------------
# Other computers
# ---------------------------------------------------------------------------
# Shared secret for machine agents. Set the same value on the server and on
# every agent.
MACHINE_TOKEN=

# ---------------------------------------------------------------------------
# Optional services
# ---------------------------------------------------------------------------
# Connected apps: sign-in, connectors, app marketplace, triggers.
# COMPOSIO_API_KEY=

# Cloud computers (Linux desktops) through Orgo. Not needed if your Bots work
# on your own machines instead.
# ORGO_API_KEY=
# ORGO_WORKSPACE_ID=
# ORGO_RAM_GB=8
# ORGO_CPU=2
# ORGO_RESOLUTION=1280x800x24

# Voice (xAI realtime). Needs XAI_API_KEY.
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0

# ---------------------------------------------------------------------------
# Memory and scheduling
# ---------------------------------------------------------------------------
# GUILD_COMPACT_CHARS=300000
# GUILD_COMPACT_KEEP_TURNS=4
# GUILD_CONSOLIDATE_IDLE_MIN=10
# GUILD_IDLE_SUSPEND_MIN=20
# GUILD_PROMPT_MEMORY_CHARS=4000
